generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String             @id
  name         String
  email        String             @unique
  phone        String             @unique
  avatarUrl    String             @default("")
  username     String             @unique
  bio          String             @default("")
  location     String             @default("")
  website      String             @default("")
  passwordHash String
  passwordSalt String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  sessions     Session[]
  otps         OtpChallenge[]
  memories     JourneyMemory[]
  wallets      Wallet[]
  walletAccount WalletAccount?
  memberships  ConversationMember[]
  messages     Message[]
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId])
}

model OtpChallenge {
  id        String   @id
  // Holds the phone number when channel = "phone", or the email address
  // when channel = "email". Kept as one column so both verification
  // channels share the same lookup/expiry/attempt logic below.
  phone     String
  channel   String   @default("phone")
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([phone, expiresAt])
}

model Conversation {
  id        String                @id
  ownerId   String?
  groupName String?
  isGroup   Boolean               @default(false)
  tripId    String?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  members   ConversationMember[]
  messages  Message[]
  @@index([ownerId])
}

model ConversationMember {
  conversationId String
  userId         String
  unreadCount    Int      @default(0)
  joinedAt       DateTime @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id              String       @id
  conversationId  String
  senderUserId    String
  recipientUserId String?
  kind            String
  text            String?
  mediaUrl        String?
  fileName        String?
  latitude        Float?
  longitude       Float?
  inviteJson      Json?
  createdAt       DateTime     @default(now())
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender          User         @relation(fields: [senderUserId], references: [id], onDelete: Cascade)
  @@index([conversationId, createdAt])
  @@index([recipientUserId])
}

model JourneyMemory {
  id        String   @id
  userId    String
  year      Int
  date      String
  place     String
  thoughts  String
  images    Json
  videos    Json
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, year, date])
}

model Wallet {
  id           String   @id
  userId       String
  tripId       String
  savedAmount  Float    @default(0)
  targetAmount Float    @default(0)
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, tripId])
}


model WalletAccount {
  id              String            @id
  userId          String            @unique
  walletHandle    String            @unique
  qrPayload       String            @unique
  currency        String            @default("INR")
  balancePaise    BigInt            @default(0)
  status          String            @default("active")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions    WalletTransaction[]
  paymentOrders    WalletPaymentOrder[]
  withdrawals      WalletWithdrawal[]
}

model WalletTransaction {
  id                    String        @id
  walletAccountId       String
  type                  String
  status                String
  amountPaise           BigInt
  currency              String        @default("INR")
  provider              String?
  providerTransactionId String?       @unique
  idempotencyKey        String        @unique
  description           String
  metadata              Json?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  walletAccount        WalletAccount @relation(fields: [walletAccountId], references: [id], onDelete: Cascade)
  @@index([walletAccountId, createdAt])
}


model WalletPaymentOrder {
  id              String        @id
  userId          String
  walletAccountId String
  provider        String
  providerOrderId String        @unique
  providerPaymentId String?     @unique
  providerQrId     String?       @unique
  providerQrImageUrl String?
  amountPaise     BigInt
  currency        String        @default("INR")
  status          String        @default("created")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  walletAccount   WalletAccount @relation(fields: [walletAccountId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}


model WalletWithdrawal {
  id                    String        @id
  walletAccountId       String
  userId                String
  amountPaise            BigInt
  currency               String        @default("INR")
  destinationType        String        @default("upi")
  destination            String
  status                 String        @default("pending")
  provider               String?
  providerPayoutId       String?       @unique
  providerFundAccountId  String?
  idempotencyKey         String        @unique
  failureReason          String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  walletAccount          WalletAccount @relation(fields: [walletAccountId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@index([walletAccountId, createdAt])
}
